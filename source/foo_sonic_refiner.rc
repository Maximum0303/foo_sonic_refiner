// Sonic Refiner resources
#include "resource.h"
#include <winres.h>

LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT
#pragma code_page(65001)

IDD_SONIC_REFINER DIALOGEX 0, 0, 560, 320
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Sonic Refiner - 0.1.0"
FONT 9, "Yu Gothic UI", 400, 0, 0x80
BEGIN
    CONTROL         "Sonic Refiner を有効にする",IDC_ENABLE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,10,190,12
    PUSHBUTTON      "ヘルプ",IDC_HELP_BUTTON,304,7,55,17
    PUSHBUTTON      "用語集",IDC_GLOSSARY_BUTTON,363,7,55,17
    PUSHBUTTON      "注意事項",IDC_NOTICE_BUTTON,422,7,59,17
    PUSHBUTTON      "ライセンス",IDC_LICENSE_BUTTON,485,7,67,17

    GROUPBOX        "音色・音場補正",IDC_STATIC,8,29,272,248

    LTEXT           "音の厚み (Depth)",IDC_STATIC,18,45,104,10
    CONTROL         "",IDC_DEPTH_SLIDER,"msctls_trackbar32",TBS_AUTOTICKS | TBS_HORZ | WS_TABSTOP,18,58,170,22
    RTEXT           "55% / 約 +4.4 dB",IDC_DEPTH_VALUE,192,64,76,10
    LTEXT           "120 Hz付近を中心に、最大約+16 dBまで厚みを加えます。",IDC_STATIC,18,82,250,10

    LTEXT           "明瞭感 (Clarity)",IDC_STATIC,18,100,104,10
    CONTROL         "",IDC_CLARITY_SLIDER,"msctls_trackbar32",TBS_AUTOTICKS | TBS_HORZ | WS_TABSTOP,18,113,170,22
    RTEXT           "45% / 約 +3.2 dB",IDC_CLARITY_VALUE,192,119,76,10
    LTEXT           "3.5 kHz付近から最大約+14 dBまで輪郭を強調します。",IDC_STATIC,18,137,250,10

    LTEXT           "音場の広がり (Width)",IDC_STATIC,18,155,120,10
    CONTROL         "",IDC_WIDTH_SLIDER,"msctls_trackbar32",TBS_AUTOTICKS | TBS_HORZ | WS_TABSTOP,18,168,170,22
    RTEXT           "50% / Side 225%",IDC_WIDTH_VALUE,192,174,76,10
    LTEXT           "約180 Hz以下を保護し、Side最大600%まで広げます。",IDC_STATIC,18,192,250,10

    LTEXT           "空間・奥行き感 (Ambience)",IDC_STATIC,18,210,140,10
    CONTROL         "",IDC_AMBIENCE_SLIDER,"msctls_trackbar32",TBS_AUTOTICKS | TBS_HORZ | WS_TABSTOP,18,223,170,22
    RTEXT           "40% / Mix 22%",IDC_AMBIENCE_VALUE,192,229,76,10
    LTEXT           "11 ms・19 msの初期反射を最大Mix 85%まで加えます。",IDC_STATIC,18,247,250,10

    GROUPBOX        "内蔵プリセット",IDC_STATIC,288,29,264,50
    COMBOBOX        IDC_BUILTIN_PRESET_COMBO,298,43,170,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "呼出",IDC_BUILTIN_PRESET_LOAD,474,42,68,16
    LTEXT           "固定プリセット。調整後は任意プリセットへ保存できます。",IDC_STATIC,298,64,244,10

    GROUPBOX        "任意プリセット（最大20件）",IDC_STATIC,288,85,264,70
    COMBOBOX        IDC_PRESET_COMBO,298,99,120,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "保存...",IDC_PRESET_SAVE,422,98,39,16
    PUSHBUTTON      "呼出",IDC_PRESET_LOAD,465,98,35,16
    PUSHBUTTON      "削除",IDC_PRESET_DELETE,504,98,38,16
    PUSHBUTTON      "書出...",IDC_PRESET_EXPORT,298,122,55,16
    PUSHBUTTON      "読込...",IDC_PRESET_IMPORT,357,122,55,16
    LTEXT           "全件をバックアップし、読み込み時は現在の一覧を置換します。",IDC_STATIC,418,121,124,24

    GROUPBOX        "出力・保護・比較",IDC_STATIC,288,161,264,116
    LTEXT           "出力ゲイン (Output Gain)",IDC_STATIC,298,174,140,10
    CONTROL         "",IDC_OUTPUT_GAIN_SLIDER,"msctls_trackbar32",TBS_AUTOTICKS | TBS_HORZ | WS_TABSTOP,298,187,150,22
    RTEXT           "+0.0 dB",IDC_OUTPUT_GAIN_VALUE,452,193,88,10
    LTEXT           "-12.0～+6.0 dB／0.5 dB刻み。自動保護の前に適用。",IDC_STATIC,298,211,244,10

    CONTROL         "自動ヘッドルーム保護",IDC_AUTO_HEADROOM,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,298,225,150,12
    LTEXT           "ピーク約-0.2 dBFSで保護し、約1.5秒で復帰します。",IDC_HEADROOM_INFO,298,239,244,10

    CONTROL         "レベルマッチ・バイパス",IDC_LEVEL_MATCH,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,298,253,150,12
    LTEXT           "処理前後の平均音量差を抑え、比較しやすくします。",IDC_LEVEL_MATCH_INFO,298,267,244,10

    LTEXT           "80%以上は強い演出用：定位・残響の変化に注意",IDC_STATIC,12,286,300,10
    LTEXT           "処理状態: 有効 / 保護オン / レベル一致オン",IDC_STATUS,12,303,300,10
    DEFPUSHBUTTON   "OK",IDOK,456,298,42,16
    PUSHBUTTON      "キャンセル",IDCANCEL,502,298,50,16
END

IDD_PRESET_NAME DIALOGEX 0, 0, 250, 78
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "任意プリセットを保存"
FONT 9, "Yu Gothic UI", 400, 0, 0x80
BEGIN
    LTEXT           "プリセット名（40文字以内）",IDC_STATIC,12,12,160,10
    EDITTEXT        IDC_PRESET_NAME_EDIT,12,27,226,14,ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "OK",IDOK,134,54,50,15
    PUSHBUTTON      "キャンセル",IDCANCEL,188,54,50,15
END


IDD_INFORMATION DIALOGEX 0, 0, 500, 310
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Sonic Refiner"
FONT 9, "Yu Gothic UI", 400, 0, 0x80
BEGIN
    EDITTEXT        IDC_INFORMATION_TEXT,10,10,480,266,ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | ES_WANTRETURN | WS_BORDER | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "閉じる",IDOK,438,286,52,16
END
